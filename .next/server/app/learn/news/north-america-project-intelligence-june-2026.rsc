0:["XM1XZHOw9hWjNinBS7iHu",[[["",{"children":["learn",{"children":["news",{"children":["north-america-project-intelligence-june-2026",{"children":["__PAGE__",{}]}]}]}]},"$undefined","$undefined",true],["",{"children":["learn",{"children":["news",{"children":["north-america-project-intelligence-june-2026",{"children":["__PAGE__",{},[["$L1",[["$","$L2",null,{}],["$","main",null,{"className":"pt-16","children":[["$","div",null,{"className":"bg-[#0d2b06] py-16 lg:py-24 relative overflow-hidden","children":[["$","div",null,{"className":"absolute inset-0 opacity-[0.07]","style":{"backgroundImage":"radial-gradient(circle at 1px 1px, #5aaf30 1px, transparent 0)","backgroundSize":"28px 28px"}}],["$","div",null,{"className":"relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","$L3",null,{"href":"/learn/news","className":"inline-flex items-center gap-1.5 text-white/50 hover:text-white text-xs font-medium mb-6 transition-colors","children":"← News & Insights"}],["$","span",null,{"className":"inline-block text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 mb-4","children":"Market Briefing"}],["$","h1",null,{"className":"text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-3","children":"North America Market Intelligence Briefing"}],["$","p",null,{"className":"text-[#6dc744] font-semibold text-lg mb-4","children":"LNG, Data Centre, Semiconductor & Power Sectors"}],["$","p",null,{"className":"text-white/55 text-sm","children":"Issue Date: June 30, 2026  ·  Coverage: North America  ·  8 min read"}]]}]]}],["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10","children":["$","div",null,{"className":"rounded-2xl overflow-hidden aspect-[16/7]","children":["$","img",null,{"src":"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=1200&auto=format&fit=crop&q=80","alt":"Industrial energy infrastructure at dusk","className":"w-full h-full object-cover"}]}]}],["$","article",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 space-y-12 text-arbiter-muted text-base leading-relaxed","children":[["$","section",null,{"className":"space-y-5","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-bold text-arbiter-green tracking-[0.2em] uppercase mb-2","children":"Overview"}],["$","h2",null,{"className":"text-2xl font-bold text-arbiter-dark","children":"Market Pulse"}]]}],["$","p",null,{"children":"The North American construction landscape is defined by a Gulf Coast LNG mega-wave colliding with an unprecedented AI data-centre and semiconductor buildout. With Corpus Christi Stage 3 nearing full completion, Golden Pass LNG commissioning its first train and beginning Train 2 systems commissioning, and LNG Canada's two trains now both operational and ramping, 2026 marks the inflection point for North American LNG export capacity. Simultaneously, over 670 hyperscale projects are in the global pipeline with approximately 35 GW of capacity currently under construction in North America alone."}],["$","div",null,{"className":"grid grid-cols-2 lg:grid-cols-4 gap-3 pt-1","children":[["$","div","Hyperscale Projects in Global Pipeline",{"className":"bg-arbiter-gray-bg border border-arbiter-border rounded-xl p-5 text-center","children":[["$","div",null,{"className":"text-2xl lg:text-[1.75rem] font-extrabold text-arbiter-green leading-none mb-2","children":"670+"}],["$","div",null,{"className":"text-[11px] text-arbiter-muted leading-snug","children":"Hyperscale Projects in Global Pipeline"}]]}],["$","div","Data Centre Capacity Under Construction (NA)",{"className":"bg-arbiter-gray-bg border border-arbiter-border rounded-xl p-5 text-center","children":[["$","div",null,{"className":"text-2xl lg:text-[1.75rem] font-extrabold text-arbiter-green leading-none mb-2","children":"35 GW"}],["$","div",null,{"className":"text-[11px] text-arbiter-muted leading-snug","children":"Data Centre Capacity Under Construction (NA)"}]]}],["$","div","Hyperscaler Capex 2025–2027 (Goldman Sachs)",{"className":"bg-arbiter-gray-bg border border-arbiter-border rounded-xl p-5 text-center","children":[["$","div",null,{"className":"text-2xl lg:text-[1.75rem] font-extrabold text-arbiter-green leading-none mb-2","children":"$$1.15T"}],["$","div",null,{"className":"text-[11px] text-arbiter-muted leading-snug","children":"Hyperscaler Capex 2025–2027 (Goldman Sachs)"}]]}],["$","div","US Data Centre Construction Spend (Dec 2025)",{"className":"bg-arbiter-gray-bg border border-arbiter-border rounded-xl p-5 text-center","children":[["$","div",null,{"className":"text-2xl lg:text-[1.75rem] font-extrabold text-arbiter-green leading-none mb-2","children":"$$45.1B/mo"}],["$","div",null,{"className":"text-[11px] text-arbiter-muted leading-snug","children":"US Data Centre Construction Spend (Dec 2025)"}]]}]]}]]}],["$","section",null,{"className":"space-y-5","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-bold text-arbiter-green tracking-[0.2em] uppercase mb-2","children":"Energy"}],["$","h2",null,{"className":"text-2xl font-bold text-arbiter-dark","children":"Key Energy Developments"}]]}],["$","div",null,{"className":"space-y-4","children":[["$","div","Corpus Christi Stage 3 (TX)",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"Corpus Christi Stage 3 (TX)"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"Trains 5 and 6 reached substantial completion in March and June 2026 respectively. Train 7 commissioning is actively underway — propane introduction approved by FERC in late June — with substantial completion expected August or September 2026. Once complete, the seven-train expansion will add over 10 MTPA to bring Corpus Christi's total capacity above 25 MTPA."}]]}],["$","div","Golden Pass LNG (TX)",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"Golden Pass LNG (TX)"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"Train 1 has shipped three cargoes but remains volatile: feedgas fell near zero on June 29 following flaring issues under investigation with Texas regulators, after peaking at nearly 600 MMcf/d on June 23. FERC approved Train 2 systems commissioning on June 25, 2026. Train 2 first LNG is expected in H1 2027. Train 3 construction and commissioning continues in parallel."}]]}],["$","div","LNG Canada (BC)",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"LNG Canada (BC)"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"Both trains are now operational. Train 1 shipped its first cargo in June 2025 and Train 2 commenced production in November 2025. As of February 2026 the facility had shipped 50 cargoes. FID on Phase 2 — which would double capacity to 28 MTPA — is expected during 2026, with the March 2026 Coastal GasLink cooperation agreement supporting the expansion pipeline case."}]]}],["$","div","DOE Export Approvals",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"DOE Export Approvals"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"Plaquemines LNG and Elba Island LNG received DOE approval in March and April 2026 to increase permitted exports by 0.5 Bcf/d and 0.1 Bcf/d respectively, expanding the regulatory runway for Gulf Coast export infrastructure."}]]}]]}]]}],["$","section",null,{"className":"space-y-5","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-bold text-arbiter-green tracking-[0.2em] uppercase mb-2","children":"Industrial"}],["$","h2",null,{"className":"text-2xl font-bold text-arbiter-dark","children":"Key Industrial Developments"}]]}],["$","div",null,{"className":"space-y-4","children":[["$","div","Data Centre & AI Buildout",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"Data Centre & AI Buildout"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"Goldman Sachs projects total hyperscaler capex from 2025 through 2027 will reach $1.15 trillion, more than double prior levels. U.S. data centre construction spending reached a monthly rate of $45.1 billion by December 2025, up 85% from two years prior."}]]}],["$","div","Semiconductors & Compute",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"Semiconductors & Compute"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"Elon Musk has proposed “Terafab” centred in Austin, which could ultimately support 1 terawatt of compute capacity annually. TSMC continues its Arizona ramp, with facilities expected to create 6,000 direct jobs alongside wider construction and supply chain employment."}]]}],["$","div","Capital Power Genesee (AB)",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"Capital Power Genesee (AB)"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"The Government of Canada relaxed environmental standards paving the way for Capital Power to expand its 1,857 MW Genesee site, which could accommodate a 1,000 MW, 1-million-square-foot hyperscale data centre."}]]}]]}]]}],["$","section",null,{"className":"space-y-5","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-bold text-arbiter-green tracking-[0.2em] uppercase mb-2","children":"Contracts"}],["$","h2",null,{"className":"text-2xl font-bold text-arbiter-dark","children":"EPC & Contract Awards"}]]}],["$","div",null,{"className":"bg-arbiter-gray-bg border border-arbiter-border rounded-xl p-6 space-y-5","children":[["$","div",null,{"children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-2","children":"Darlington SMR Supply Chain"}],["$","ul",null,{"className":"space-y-1.5 text-sm","children":[["$","li","Walters Group — $44.5M structural steel award",{"className":"flex gap-2.5","children":[["$","span",null,{"className":"mt-2 w-1.5 h-1.5 rounded-full bg-arbiter-green flex-shrink-0"}],["$","span",null,{"children":"Walters Group — $44.5M structural steel award"}]]}],["$","li","Marmon Industrial Water — $17.8M condensate purification package",{"className":"flex gap-2.5","children":[["$","span",null,{"className":"mt-2 w-1.5 h-1.5 rounded-full bg-arbiter-green flex-shrink-0"}],["$","span",null,{"children":"Marmon Industrial Water — $17.8M condensate purification package"}]]}],["$","li","Tractel — $9.9M reactor building weather enclosure",{"className":"flex gap-2.5","children":[["$","span",null,{"className":"mt-2 w-1.5 h-1.5 rounded-full bg-arbiter-green flex-shrink-0"}],["$","span",null,{"children":"Tractel — $9.9M reactor building weather enclosure"}]]}]]}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-2","children":"LNG EPC"}],["$","ul",null,{"className":"space-y-1.5 text-sm","children":[["$","li","McDermott is executing Woodfibre LNG, one of the company's most significant onshore energy projects in North America, with an EPC value exceeding USD 500M.",{"className":"flex gap-2.5","children":[["$","span",null,{"className":"mt-2 w-1.5 h-1.5 rounded-full bg-arbiter-green flex-shrink-0"}],["$","span",null,{"children":"McDermott is executing Woodfibre LNG, one of the company's most significant onshore energy projects in North America, with an EPC value exceeding USD 500M."}]]}],["$","li","Bechtel remains the lead LNG EPC globally, having delivered or actively executing Sabine Pass, Corpus Christi Stages 3 & 4, Driftwood, Rio Grande, and Port Arthur LNG.",{"className":"flex gap-2.5","children":[["$","span",null,{"className":"mt-2 w-1.5 h-1.5 rounded-full bg-arbiter-green flex-shrink-0"}],["$","span",null,{"children":"Bechtel remains the lead LNG EPC globally, having delivered or actively executing Sabine Pass, Corpus Christi Stages 3 & 4, Driftwood, Rio Grande, and Port Arthur LNG."}]]}]]}]]}]]}]]}],["$","section",null,{"className":"space-y-5","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-bold text-arbiter-green tracking-[0.2em] uppercase mb-2","children":"New Entries"}],["$","h2",null,{"className":"text-2xl font-bold text-arbiter-dark","children":"New Projects to Track"}]]}],["$","div",null,{"className":"space-y-4","children":[["$","div","Alaska LNG (Glenfarne)",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"Alaska LNG (Glenfarne)"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"Proposed 20 Mt/y export plant in Nikiski. Pipeline FID anticipated late 2025 remains pending. Glenfarne has enlisted Worley ahead of the FID. One to watch as U.S. export policy continues to favour new capacity."}]]}],["$","div","Penzance High Impact Intelligence Center (WV)",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"Penzance High Impact Intelligence Center (WV)"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"$$4 billion campus in Berkeley County, West Virginia, delivering 600 MW of IT capacity."}]]}],["$","div","Rio Bravo Pipeline (TX)",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"Rio Bravo Pipeline (TX)"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"138-mile pipeline with capacity up to 4.5 Bcf/d delivering feedgas to NextDecade's Rio Grande LNG terminal."}]]}],["$","div","Williams Southeast Supply Enhancement (VA)",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"Williams Southeast Supply Enhancement (VA)"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"1.6 Bcf/d expansion of the Transcontinental Pipeline expected online in 2027, underpinning feedgas supply to Gulf Coast and Southeast demand centres."}]]}],["$","div","Corpus Christi Stage 4 (TX)",{"className":"border-l-2 border-arbiter-green bg-arbiter-gray-bg rounded-r-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-1.5","children":"Corpus Christi Stage 4 (TX)"}],["$","p",null,{"className":"text-sm text-arbiter-muted leading-relaxed","children":"Cheniere filed a FERC application in February 2026 for four large-scale trains adding ~24 MTPA. First commissioning is estimated early 2032. Represents the next major EPC wave at the Corpus Christi complex."}]]}]]}],["$","p",null,{"className":"text-xs italic text-arbiter-muted","children":"Briefing reflects sources current to June 30, 2026. Golden Pass Train 1 ramp-up remains volatile — recommend validating feedgas and commissioning status directly with site teams before engagement."}]]}],["$","section",null,{"className":"space-y-5","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-bold text-arbiter-green tracking-[0.2em] uppercase mb-2","children":"About Arbiter"}],["$","h2",null,{"className":"text-2xl font-bold text-arbiter-dark","children":"Where Arbiter Fits In"}]]}],["$","p",null,{"children":"Every project listed in this briefing shares a common challenge: keeping complex, multi-discipline scopes organised, accountable, and on track from first construction activity through to final handover. That's exactly where Arbiter operates. As project scale and complexity grows across LNG facilities, data centres, semiconductor fabs, pipelines, power generation, and nuclear, the demand for structured, software-driven project controls has never been higher."}],["$","div",null,{"className":"grid sm:grid-cols-3 gap-3","children":[["$","div","Construction Controls",{"className":"bg-arbiter-gray-bg border border-arbiter-border rounded-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-2","children":"Construction Controls"}],["$","p",null,{"className":"text-xs text-arbiter-muted leading-relaxed","children":"Arbiter tracks every punch item, ITR, and work package from first-fix through mechanical completion, giving project teams a single source of truth across multi-discipline scopes."}]]}],["$","div","Pre-Commissioning & Commissioning",{"className":"bg-arbiter-gray-bg border border-arbiter-border rounded-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-2","children":"Pre-Commissioning & Commissioning"}],["$","p",null,{"className":"text-xs text-arbiter-muted leading-relaxed","children":"Structured subsystem walkdowns, loop checks, and energisation sequencing managed in one platform — reducing rework and keeping complex systems aligned to schedule."}]]}],["$","div","Handover & Turnover",{"className":"bg-arbiter-gray-bg border border-arbiter-border rounded-xl p-5","children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-sm mb-2","children":"Handover & Turnover"}],["$","p",null,{"className":"text-xs text-arbiter-muted leading-relaxed","children":"Automated, auditable handover documentation reduces the time and risk of transferring complex facilities to operations, regardless of sector or project size."}]]}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"font-bold text-arbiter-dark text-base mb-3","children":"How Arbiter Applies Across This Briefing"}],["$","div",null,{"className":"overflow-hidden border border-arbiter-border rounded-xl","children":["$","table",null,{"className":"w-full text-left text-sm","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-arbiter-green text-white","children":[["$","th",null,{"className":"px-4 py-3 font-semibold text-xs uppercase tracking-wide","children":"Project Type"}],["$","th",null,{"className":"px-4 py-3 font-semibold text-xs uppercase tracking-wide","children":"Arbiter Application"}]]}]}],["$","tbody",null,{"children":[["$","tr","LNG Facilities",{"className":"bg-white","children":[["$","td",null,{"className":"px-4 py-3 align-top","children":[["$","span",null,{"className":"font-bold text-arbiter-dark block","children":"LNG Facilities"}],["$","span",null,{"className":"text-xs text-arbiter-muted","children":"Golden Pass, Corpus Christi, Woodfibre, Cedar, Port Arthur, Rio Grande"}]]}],["$","td",null,{"className":"px-4 py-3 align-top text-arbiter-muted","children":"Multi-discipline handover packages; punch and ITR management across large piping, rotating equipment, and controls scopes; train-by-train commissioning progress tracking; regulatory closeout documentation."}]]}],["$","tr","Data Centres & Semiconductor Fabs",{"className":"bg-arbiter-gray-bg","children":[["$","td",null,{"className":"px-4 py-3 align-top","children":[["$","span",null,{"className":"font-bold text-arbiter-dark block","children":"Data Centres & Semiconductor Fabs"}],["$","span",null,{"className":"text-xs tex